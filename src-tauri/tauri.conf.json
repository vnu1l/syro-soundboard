{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syro Soundboard",
  "version": "0.3.0",
  "identifier": "com.syro.soundboard",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Syro Soundboard",
        "width": 1380,
        "height": 860,
        "minWidth": 980,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Music",
    "shortDescription": "Fast native soundboard and live audio timeline",
    "longDescription": "Syro Soundboard is a lightweight native Windows soundboard, live audio timeline, recorder and effects workspace.",
    "icon": [
      "icons/256x256.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
